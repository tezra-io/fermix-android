    <string name="instance_link_older">Update Fermix on %1$s</string>
    <string name="instance_link_newer">Update Fermix on this phone</string>
    <!-- Section 9.4 names the state and the deck has no sentence for it (the canon says so): the task's words. -->
    <string name="instance_link_protocol_error">Protocol error</string>
