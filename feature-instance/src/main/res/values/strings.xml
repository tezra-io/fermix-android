<!--
  The Instance screen's words and a link's (design sections 9.4, 13.5, 13.7 and the copy deck, 13.9) verbatim
  unless a comment names another source; the host is always a format argument.
-->
<resources>
    <!-- A link's words: section 13.5's subtitle, section 9.4's rows and section 13.9's deck. -->
    <string name="instance_link_connecting">Connecting…</string>
    <string name="instance_link_waiting">Waiting for network…</string>
    <string name="instance_link_cannot_reach">Can\'t reach %1$s</string>
    <string name="instance_link_updating">Updating…</string>
