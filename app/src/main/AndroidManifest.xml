<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      androidx.core declares this one so that registerReceiver can emulate RECEIVER_NOT_EXPORTED below
      API 33; on minSdk 35 the platform flag does that and the permission is never used.
    -->
    <permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />
    <uses-permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />

    <!-- The pairing-wait notification's short foreground service (design section 12.5). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Onboarding's step 7 asks for it (design section 13.3), and the pairing wait posts with it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The app lock's prompt, BIOMETRIC_STRONG | DEVICE_CREDENTIAL (design section 13.7). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:name=".FermixApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Fermix"
        android:usesCleartextTraffic="false">

        <!--
          singleTop: a chat's deep link from a notification or a shortcut reaches the activity showing, as a new
          intent. No filter declares the link, so no browser or link offers it, but the activity is exported for
          the launcher, so any app can send it an explicit ACTION_VIEW with one; all such a link does is open
          the chat of a Fermix already paired, and anything else is ignored (appIntentOf).
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Add Fermix" as an app shortcut (design section 9.4). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <service
            android:name=".PairingWaitService"
            android:exported="false"
            android:foregroundServiceType="shortService" />
    </application>

</manifest>
