<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      androidx.core declares this one so that registerReceiver can emulate RECEIVER_NOT_EXPORTED below
      API 33; on minSdk 35 the platform flag does that and the permission is never used.
    -->
    <permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />
    <uses-permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />

    <!-- The short foreground services of the pairing wait and of an upload in flight (design section 12.5). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Onboarding's step 7 asks for it (design section 13.3), and the pairing wait posts with it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The app lock's prompt, BIOMETRIC_STRONG | DEVICE_CREDENTIAL (design section 13.7). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:name=".FermixApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Fermix"
        android:usesCleartextTraffic="false">

        <!--
          singleTop: a chat's deep link from a notification or a shortcut reaches the activity showing, as a new
          intent. No filter declares the link, so no browser or link offers it, but the activity is exported for
          the launcher, so any app can send it an explicit ACTION_VIEW with one; all such a link does is open
          the chat of a Fermix already paired, and anything else is ignored (appIntentOf).
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Add Fermix" as an app shortcut (design section 9.4). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <service
            android:name=".PairingWaitService"
            android:exported="false"
            android:foregroundServiceType="shortService" />

        <!-- An upload in flight finishes out of sight (design sections 8.5 and 12.5); no type needs a permission. -->
        <service
            android:name=".UploadService"
            android:exported="false"
            android:foregroundServiceType="shortService" />

        <!--
          FCM's data messages, new tokens and dropped messages (design section 10). Not exported: Firebase's own
          receiver, which holds com.google.android.c2dm.permission.SEND, starts it with an explicit intent.
        -->
        <service
            android:name=".FermixMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!--
          No token is made at launch: the first is asked for when a daemon is to be registered, so a phone
          whose notifications are all off never reaches FCM. The token is asked for with
          FirebaseMessaging.register and comes to the service's onRegistered, the API that replaces the
          deprecated getToken and onNewToken, which Firebase enables only with the installation-id flag.
        -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />
        <meta-data
            android:name="firebase_messaging_installation_id_enabled"
            android:value="true" />
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="false" />
        <!--
          Firebase otherwise makes Play services the app's notification delegate, which shows an FCM message's
          notification block as the app without ever calling it: past the app lock, PushInbox and handleIntent's
          stripping (design section 10, "the app always renders"). FermixMessagingServiceTest reads it.
        -->
        <meta-data
            android:name="firebase_messaging_notification_delegation_enabled"
            android:value="false" />
    </application>

</manifest>
