<?xml version="1.0" encoding="utf-8"?>
<!-- "Add Fermix" as an app shortcut (design section 9.4): the activity starts a pairing from the Chats list. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:shortcutId="add_fermix"
        android:shortcutShortLabel="@string/chats_add">
        <intent
            android:action="io.tezra.fermix.action.ADD_FERMIX"
            android:targetClass="io.tezra.fermix.MainActivity"
            android:targetPackage="io.tezra.fermix" />
    </shortcut>
</shortcuts>
