# Gradle and Kotlin
.gradle/
build/
.kotlin/

# Android Studio and IntelliJ
.idea/
*.iml
captures/
.externalNativeBuild/
.cxx/

# Machine-local: the SDK path, and signing material that never enters the tree (onboarding section 2.5)
local.properties
keystore.properties
*.jks
*.keystore
*.p12
*.pk8
*.pem

# Built packages, including the ones Android Studio's "Generate Signed App Bundle or APK" writes
# outside build/
/app/release/
*.apk
*.aab

# Per Firebase project, kept out of the tree (onboarding section 2.4), and the Play and FCM
# service-account keys (CI/CD design section 4.5). The one exception is the stub with a placeholder
# project that every pull-request build compiles with (CI/CD design section 3); a real file goes in
# app/src/debug/ or app/src/release/, which the services plugin reads first, and stays ignored there.
google-services.json
!/app/google-services.json
*service-account*.json

# What Python writes running the release scripts' tests (scripts/tests)
__pycache__/

# No screenshot is tracked, from 2026-10-05 on (the owner: "git ignore those images"): a module's
# src/test/screenshots holds what `./gradlew recordRoborazziDebug` last drew on this machine, its own
# references for a compare, and docs/app-shots what scripts/app_shots.sh made from them. CI's screens job
# draws its own and uploads docs/app-shots as an artifact; the images pushed before stay in history.
*/src/test/screenshots/
docs/app-shots/

# OS and editors
.DS_Store
*.swp
