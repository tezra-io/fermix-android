#!/usr/bin/env python3
"""A stand-in for sleep in the emulator scripts' tests, so that a wait of 30 polls takes a second or two.

  sleep <seconds>
      Records <seconds> as a line of $FAKE_DEVICE_ROOT/sleeps and returns after STAND_IN_SECONDS, whatever it was
      asked: time enough for a process sent a signal to be gone by the next poll on a loaded machine. Past
      MAX_SLEEPS calls it fails, as the script under test is waiting without a bound.
"""
import os
import pathlib
import sys
import time

ROOT = pathlib.Path(os.environ["FAKE_DEVICE_ROOT"])
STAND_IN_SECONDS = 0.05
# Far more than any bound the scripts set, far fewer than an endless loop runs in a test's time.
MAX_SLEEPS = 200


def main():
    if len(sys.argv) != 2:
        sys.exit(f"fake sleep: no answer for {sys.argv[1:]}")
    log = ROOT / "sleeps"
    count = len(log.read_text(encoding="utf-8").splitlines()) if log.exists() else 0
    if count >= MAX_SLEEPS:
        sys.exit(f"fake sleep: asked {count + 1} times, by a wait with no bound")
    with open(log, "a", encoding="utf-8") as sleeps:
        sleeps.write(sys.argv[1] + "\n")
    time.sleep(STAND_IN_SECONDS)
    return 0


sys.exit(main())
