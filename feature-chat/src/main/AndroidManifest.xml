<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The voice note (design section 8.5), asked for on the first hold of the mic, after its rationale. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!--
      The attach sheet's Camera (design section 8.5, CameraX capture) asks for the permission onboarding's scan
      declares, which no camera feature requires.
    -->
    <uses-permission android:name="android.permission.CAMERA" />

    <application>
        <!--
          A blob opened through the chooser, shared or saved (design section 13.5): the copy under the cache's
          shared directory, read-only to the app the owner chose, for that intent alone.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.chat.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/chat_files" />
        </provider>
    </application>
</manifest>
